{
  "name": "mcp-model-training-store",
  "version": "0.2.0",
  "description": "Learning example: paid model-training MCP server — Google (GCP) bearer auth, Streamable HTTP, long-running Tasks running scikit-learn/XGBoost AutoML, MCP Apps dashboard, Postgres commerce records",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espechtsoftware/TasksExample.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "node scripts/build-ui.mjs",
    "dev": "npm run build:ui && tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build:ui && tsx scripts/smoke.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
