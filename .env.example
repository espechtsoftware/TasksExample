# Copy this file to .env and fill in the values you need, then load it before
# running npm scripts, e.g.:
#   set -a; source .env; set +a; npm run dev
# or (Node 20.6+):
#   node --env-file=.env dist/src/index.js

# Required. Audience (`aud` claim) your callers mint Google ID tokens for —
# typically this server's public URL or an OAuth client ID.
GOOGLE_AUDIENCE=https://mcp.example.com/mcp

# Optional. Restrict to a Google Workspace domain (the `hd` claim).
GOOGLE_ALLOWED_DOMAIN=example.com

# Optional. Comma-separated allowlist of exact account emails (user or
# service-account) permitted to call this server.
GOOGLE_ALLOWED_EMAILS=me@example.com

# Optional. Postgres connection string. Unset -> embedded PGlite under
# ${DATA_DIR}/db (fine for learning; use a managed Postgres in production).
# The local dev Postgres runs in Docker on a non-standard host port (55432)
# so 5432 stays free for other local Postgres instances — see
# docker-compose.yml. Start it with: docker compose up -d
DATABASE_URL=postgres://tasksexample:tasksexample@localhost:55432/tasksexample

# Optional. Root directory for datasets, job configs, model artifacts and the
# embedded DB. Defaults to "var".
DATA_DIR=var

# Optional. Python interpreter with scikit-learn/xgboost/pandas/joblib
# installed (see python/requirements.txt). Point this at your venv, e.g.
# .venv/bin/python. Defaults to "python3".
PYTHON_BIN=.venv/bin/python

# Optional. TCP port the HTTP server listens on. Defaults to 3000.
PORT=3000

# Optional. Public base URL of this server (no trailing slash), used to build
# the RFC 9728 protected-resource metadata document. Defaults to
# http://localhost:${PORT}.
MCP_PUBLIC_URL=http://localhost:3000
